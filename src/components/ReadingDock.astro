---
import type { MarkdownHeading } from 'astro';
import { site } from '../data/site';
interface Props {
  headings: MarkdownHeading[];
}
const sections = Astro.props.headings.filter(
  (heading) => heading.depth <= 3 && heading.slug !== 'footnote-label',
);
---

<nav class="dock glass" aria-label="Reading" data-dock>
  <a href="/" class="home">
    {site.labels.home}
  </a>
  {sections.length > 1 && (
    <button type="button" class="current" popovertarget="contents" data-current>
      {site.labels.contents}
    </button>
  )}
  <a href="#top" class="top" aria-label={site.labels.top}>
    ↑
  </a>
</nav>
{sections.length > 1 && (
  <div
    id="contents"
    popover
    class="contents glass"
    aria-label={site.labels.contents}
  >
    <ol>
      {sections.map((heading) => (
        <li class:list={[`depth-${heading.depth}`]}>
          <a href={`#${heading.slug}`} data-slug={heading.slug}>
            {heading.text}
          </a>
        </li>
      ))}
    </ol>
  </div>
)}
<script>
  const dock = document.querySelector<HTMLElement>('[data-dock]');
  const current = document.querySelector<HTMLElement>('[data-current]');
  const contents = document.querySelector<HTMLElement>('#contents');
  if (dock) {
    // Show once the reader is past the title, hide while they read forward, return when they scroll back.
    let last = scrollY;
    const update = () => {
      const y = scrollY;
      const nearEnd = y + innerHeight > document.body.scrollHeight - 200;
      dock.dataset.shown = String(y > 320 && (y < last || nearEnd));
      last = y;
    };
    addEventListener('scroll', update, { passive: true });
    update();
    contents?.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) contents.hidePopover();
    });
  }
  if (current) {
    const label = current.textContent;
    const headings = [
      ...document.querySelectorAll<HTMLElement>('.prose :is(h2, h3)[id]'),
    ];
    const observer = new IntersectionObserver(
      () => {
        const passed = headings.filter(
          (heading) => heading.getBoundingClientRect().top < innerHeight * 0.3,
        );
        current.textContent = passed.at(-1)?.textContent ?? label;
      },
      { rootMargin: '0px 0px -70% 0px' },
    );
    headings.forEach((heading) => observer.observe(heading));
  }
</script>
<style>
  .dock {
    position: fixed;
    left: 50%;
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 5;
    display: flex;
    align-items: center;
    gap: var(--space-1);
    max-width: calc(100% - 2rem);
    padding: 4px;
    border-radius: 999px;
    font-size: var(--type-small);
    translate: -50% 0;
    transition:
      translate var(--motion) var(--ease),
      opacity var(--motion) var(--ease);
  }
  .dock[data-shown='false'] {
    translate: -50% calc(100% + 1.5rem);
    opacity: 0;
    pointer-events: none;
  }
  .dock:focus-within {
    translate: -50% 0;
    opacity: 1;
    pointer-events: auto;
  }
  .dock a,
  .dock button {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 var(--space-4);
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--text);
    font: inherit;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
  }
  .current {
    min-width: 0;
    max-width: 14rem;
    overflow: hidden;
    text-overflow: ellipsis;
    display: block !important;
    line-height: 40px;
    background: oklch(1 0 0 / 0.07) !important;
  }
  .top {
    color: var(--text-2) !important;
  }
  .contents {
    position: fixed;
    inset: auto 0 calc(max(1rem, env(safe-area-inset-bottom)) + 56px) 0;
    width: min(22rem, calc(100% - 2rem));
    max-height: 60svh;
    margin: 0 auto;
    padding: var(--space-3);
    overflow: auto;
    border-radius: 18px;
    color: var(--text);
    opacity: 0;
    translate: 0 8px;
    transition:
      opacity var(--motion) var(--ease),
      translate var(--motion) var(--ease),
      display var(--motion) allow-discrete,
      overlay var(--motion) allow-discrete;
  }
  .contents:popover-open {
    opacity: 1;
    translate: 0 0;
  }
  @starting-style {
    .contents:popover-open {
      opacity: 0;
      translate: 0 8px;
    }
  }
  .contents a {
    display: flex;
    align-items: center;
    min-height: var(--touch);
    padding: 0 var(--space-3);
    border-radius: 10px;
    text-decoration: none;
    line-height: 1.3;
  }
  .depth-3 a {
    padding-left: var(--space-6);
    color: var(--text-2);
  }
  @media (max-width: 760px) {
    .current {
      max-width: calc(100vw - 11rem);
    }
  }
</style>
